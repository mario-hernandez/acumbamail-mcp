# Copia este archivo a `.env` y rellena tu token.
# El token de Acumbamail se obtiene logueado en https://acumbamail.com/apidoc/
# NUNCA subas tu `.env` real al repositorio (ya está en .gitignore).

ACUMBAMAIL_AUTH_TOKEN=tu_token_aqui

# Opcional: timeout de las peticiones HTTP en ms (por defecto 30000)
# ACUMBAMAIL_TIMEOUT_MS=30000
